{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "care-one",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "careone-db",
      "database_id": "6f8e95cb-25df-434e-9b6b-c4dd18b91f2d",
      "migrations_dir": "migrations"
    },
    {
      "binding": "FILES_DB",
      "database_name": "careone-files",
      "database_id": "6e4542af-f012-4c16-8e9b-5287427d177e",
      "migrations_dir": "migrations-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REMINDERS",
        "queue": "careone-reminders"
      }
    ],
    "consumers": [
      {
        "queue": "careone-reminders",
        "max_retries": 3,
        "dead_letter_queue": "careone-reminders-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *", "30 18 * * *"]
  },
  "ratelimits": [
    {
      "name": "CODE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
